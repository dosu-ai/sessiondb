{
  "name": "@dosu/sessiondb",
  "version": "0.2.0",
  "description": "The sessiondb SDK: redact, normalize and store coding-agent sessions in the sessionstorage layout, and read them back. The server is a thin HTTP wrapper around this package.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dosu-ai/sessiondb.git",
    "directory": "sdks/typescript"
  },
  "keywords": [
    "sessiondb",
    "sessionstorage",
    "coding-agent",
    "claude-code",
    "cursor",
    "codex",
    "trajectory",
    "redaction"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-utils.ts",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "fixtures": "bun run scripts/fixtures.ts",
    "goldens": "bun run scripts/goldens.ts"
  },
  "dependencies": {
    "@letta-ai/trajectory": "^0.3.0"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=20"
  }
}
