{
  "name": "sessiondb-workspace",
  "private": true,
  "description": "sessiondb: coding-agent sessions as a durable, redacted, content-addressed store. The TypeScript SDK (sdks/typescript), the server that wraps it (server), and the contract both honour (spec).",
  "license": "MIT",
  "repository": "github:dosu-ai/sessiondb",
  "type": "module",
  "workspaces": [
    "sdks/typescript",
    "server"
  ],
  "scripts": {
    "start": "bun run --cwd server start",
    "dev": "bun run --cwd server dev",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome lint .",
    "format": "bunx biome format --write .",
    "check": "bunx biome check .",
    "fixtures": "bun run --cwd sdks/typescript fixtures",
    "goldens": "bun run --cwd sdks/typescript goldens"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "1.4.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
