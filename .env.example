# Copy to .env (gitignored). Bun reads it from the working directory; docker compose passes it
# to the container. Every variable is described in docs/server.md.

# Who may use the server: name:token pairs, comma-separated, one per person. Sessions are
# filed under owners/<name>/ and a token reads only its own. Tokens are 16+ characters:
#   openssl rand -hex 24
SESSIONDB_TOKENS=alice:replace-with-openssl-rand-hex-24,bob:replace-with-another
# One person? A single token with no name files under owners/default/:
# SESSIONDB_TOKEN=replace-with-openssl-rand-hex-24

# Where sessions go. One of:
#   r2://bucket/prefix     + R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
#   s3://bucket/prefix     + AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
#   s3://bucket/prefix     + S3_ENDPOINT and the AWS_* keys, for MinIO / Backblaze / Wasabi / …
#   file:///path           a folder on this machine (development; the Docker image mounts /data)
SESSIONDB_STORE_URL=file:///tmp/sessiondb
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional.
# PORT=7200                  # what the server listens on
# SESSIONDB_PORT=7200        # docker compose only: the host port to publish
