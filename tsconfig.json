{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": ["bun"]
  },
  "include": [
    "sdks/typescript/src/**/*",
    "sdks/typescript/scripts/**/*",
    "server/src/**/*",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
